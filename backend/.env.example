# Copy to backend/.env and fill in. Never commit the filled-in file.
# In NODE_ENV=production the server exits at boot if a required value is missing.

# ─── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# CORS allowlist. Comma-separate multiple origins.
CLIENT_URL=http://localhost:5173

# ─── Supabase PostgreSQL ──────────────────────────────────────────────────────
# Preferred: the pooled connection string from
# Supabase → Project Settings → Database → Connection string → URI
# Use port 5432 (session pooler) for a long-running Node server.
DATABASE_URL=

# Alternative to DATABASE_URL. Used only when DATABASE_URL is empty.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
# Must be at least 32 characters in production. Rotating this signs out all users.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ─── AI provider settings storage ─────────────────────────────────────────────
# Encrypts API keys that an admin saves through the in-app Settings page
# (AES-256-GCM). Required only if you want to configure providers from the UI —
# keys set via the environment variables below work without it.
#
# Generate with:  openssl rand -base64 32
#
# Losing this value makes previously saved keys undecryptable; an admin just
# re-enters them. Changing it has the same effect. It must never be committed.
SETTINGS_ENCRYPTION_KEY=

# ─── AI providers ─────────────────────────────────────────────────────────────
# Only the selected provider's key is required.
# These are backend-only. Never mirror them into a VITE_ variable.
#
# A key saved in the Settings page takes precedence over the matching variable
# here, so an admin can switch providers without a redeploy.
AI_PROVIDER=gemini
AI_TIMEOUT_MS=20000

GEMINI_API_KEY=
GEMINI_MODEL=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ─── YouTube ──────────────────────────────────────────────────────────────────
# Optional. Video embedding uses the keyless oEmbed endpoint and needs nothing here.
# This key only enables the optional tutorial-search feature.
YOUTUBE_API_KEY=
