# Frontend environment. Copy to .env.
#
# WARNING: every VITE_-prefixed variable is inlined into the public JavaScript
# bundle at build time and is readable by anyone who visits the site.
# Never put an API key, database URL, or secret here.
#
# All AI provider keys live in backend/.env and are proxied through the backend.

# Base path for API requests. In development the Vite dev server proxies this
# to the backend on :5000, so the default is correct for local work.
VITE_API_URL=/api
