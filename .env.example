# ─────────────────────────────────────────────────────────────────────────────
# EDUBUILD environment
#
# LOCAL:  cp .env.example .env.local   then fill in the REQUIRED block below.
# DEPLOY: most hosts (Vercel, Netlify, Render, Railway) let you paste or upload
#         a whole .env file on their environment-variables screen. Fill this in
#         first, then paste it. Comments and blank lines are ignored.
#
# .env.local is gitignored. Never commit a filled-in copy.
# ─────────────────────────────────────────────────────────────────────────────


# ═══ REQUIRED ════════════════════════════════════════════════════════════════
# The app will not work without these three.

# 1. Supabase connection string.
#    Supabase → Project Settings → Database → Connection string
#
#    Always use a POOLER host, never the direct one. Which port depends on how
#    you run it:
#
#      Serverless (Vercel, Netlify, Lambda) → transaction pooler, port 6543
#      Long-running server (a VM, a container, `next start`) → session pooler, 5432
#
#      postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:6543/postgres
#
#    Note the host prefix is aws-0- for some projects and aws-1- for others;
#    copy it from the dashboard rather than assuming.
#
#    Do NOT use the direct host (db.<project-ref>.supabase.co). It resolves to
#    IPv6 only, and most hosting providers cannot reach it — the app boots and
#    then fails every database call with a 500.
DATABASE_URL=

# 2. Signs session tokens. Generate with:  openssl rand -base64 48
#    At least 32 characters. Changing it signs everyone out.
JWT_SECRET=

# 3. Encrypts provider API keys saved through the admin AI Settings page
#    (AES-256-GCM). Generate with:  openssl rand -base64 32
#
#    Without it the Settings page disables key entry entirely.
#    KEEP IT STABLE — if it changes, saved keys can no longer be decrypted and
#    an admin has to re-enter them.
SETTINGS_ENCRYPTION_KEY=


# ═══ RECOMMENDED IN PRODUCTION ═══════════════════════════════════════════════

# Your deployed origin, e.g. https://edubuild.example.com
# Used only as a CORS allowlist for a separate client calling this API.
# Same-origin requests — the normal case — do not need it.
CLIENT_URL=


# ═══ AI PROVIDER — all optional ══════════════════════════════════════════════
# None of this is needed to deploy. Once SETTINGS_ENCRYPTION_KEY is set, an
# admin can add and test a key in the app at /admin/ai-settings, which is the
# easier path — a key saved there overrides the matching variable below.
#
# These are server-only. Never rename one to NEXT_PUBLIC_*: that prefix inlines
# the value into the public JavaScript bundle, where anyone can read it.

# gemini | openai | groq | openrouter | mock
AI_PROVIDER=gemini
AI_TIMEOUT_MS=20000

# Only the selected provider's key is needed.
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Leave blank to use each provider's default model.
GEMINI_MODEL=
OPENAI_MODEL=
GROQ_MODEL=
OPENROUTER_MODEL=


# ═══ OPTIONAL ════════════════════════════════════════════════════════════════

# Video embedding uses the keyless oEmbed endpoint and needs nothing here.
# This key only enables the not-yet-built tutorial-search feature.
YOUTUBE_API_KEY=

# Alternative to DATABASE_URL. Used only when DATABASE_URL is empty.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

# Defaults are fine. PORT is normally set by the host.
JWT_EXPIRES_IN=7d
